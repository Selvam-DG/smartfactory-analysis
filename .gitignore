
# ----------------------------
# Python cache and bytecode
# ----------------------------
__pycache__/
*.py[cod]
*$py.class

# ----------------------------
# Virtual environments
# ----------------------------
.venv/
venv/
env/
ENV/

# ----------------------------
# Python packaging
# ----------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ----------------------------
# Environment variables and secrets
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# Test and coverage outputs
# ----------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.junit_cache/

# ----------------------------
# Linting / formatting caches
# ----------------------------
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# ----------------------------
# Jupyter notebooks
# ----------------------------
.ipynb_checkpoints/

# ----------------------------
# Local generated data
# Keep folder structure, ignore generated files
# ----------------------------
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/external/*
!data/external/.gitkeep
!data/external/azure_pm/
data/external/azure_pm/*
!data/external/azure_pm/.gitkeep

# ----------------------------
# Model artifacts
# ----------------------------
models/*
!models/.gitkeep
!models/README.md

*.joblib
*.pkl
*.pickle

# ----------------------------
# Logs
# ----------------------------
logs/*
!logs/.gitkeep
*.log

# ----------------------------
# Docker / local database volumes
# ----------------------------
docker/postgres_data/
docker/pgadmin_data/
postgres_data/
pgadmin_data/

# ----------------------------
# Streamlit
# ----------------------------
.streamlit/secrets.toml

# ----------------------------
# OS files
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# IDE/editor files
# ----------------------------
.vscode/
.idea/
*.swp
*.swo

# ----------------------------
# Temporary files
# ----------------------------
tmp/
temp/
*.tmp
*.bak

# ----------------------------
# SQL dump / backup files
# ----------------------------
*.sql.gz
*.dump
*.backup

# ----------------------------
# Misc
# ----------------------------
.cache/